{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../shared/src/**/*.ts"],
  "exclude": [
    "src/engine/engineClient.ts"
  ]
}
// engineClient.ts is the ZeroMQ path to the C++ engine and is excluded until
// that engine is wired up — it imports `zeromq`, which is not a dependency yet.
// Re-include it in the same change that adds the dependency, not before.

