# Copy to infra/.env and fill in. Compose reads it automatically.
#   cp infra/.env.example infra/.env

# Signing key for access tokens. Generate a fresh one, never reuse across
# environments — a shared key means a token minted in staging is valid in prod.
#   openssl rand -base64 48
JWT_SECRET=

# The origin players type into a browser, scheme included. Used for CORS.
#   https://arena.example.com   (or http://localhost:8080 for a local prod run)
PUBLIC_ORIGIN=http://localhost:8080

POSTGRES_PASSWORD=

# Host port nginx binds to. Put a TLS terminator in front of this in production.
HTTP_PORT=8080
